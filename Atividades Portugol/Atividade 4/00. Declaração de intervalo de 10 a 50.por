programa {
  funcao inicio() {

    escreva ("DECLARAÇÃO DE INTERVALO DE 10 A 50 \n")

    inteiro valor

    escreva ("\nInsira um valor numérico: ")
    leia (valor)

    se (valor >= 10 e valor <= 50)
    {
      escreva ("\nValor dentro do intervalo!")
    }
    senao
    {
      escreva ("\nValor fora do intervalo!")
    }
    
  }
}
