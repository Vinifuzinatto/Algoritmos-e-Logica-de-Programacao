programa {
  funcao inicio() {

    escreva ("CALCULO DA ÁREA DE UM TRIÂNGULO QUALQUER! \n")

    real base, altura, area

    escreva ("\nInsira o valor da base desse triângulo: ")
    leia (base)
     escreva ("Insira o valor da altura desse triângulo: ")
    leia (altura)

    area = base * altura / 2

    escreva ("\nA área desse triângulo equivale a ", area, " cm²\n")
  }
}
