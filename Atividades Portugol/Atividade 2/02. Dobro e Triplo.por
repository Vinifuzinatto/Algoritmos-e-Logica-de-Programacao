programa {
  funcao inicio() {

    escreva ("DOBRO E TRIPLO DE UM NÚMERO QUALQUER! \n")

    inteiro dobro, triplo, valor

    escreva ("\nInsira um número: ")
    leia (valor)

    dobro = valor * 2
    triplo = valor * 3

    escreva ("\nO dobro desse número é ", dobro, "\n")
    escreva ("O triplo desse número é ", triplo, "\n")
  }
    
  }
}
