programa {
  funcao inicio() {

    escreva ("NÚMERO PAR/ÍMPAR! \n")

    real valor, par, impar

    escreva ("\nInsira um número: ")
    leia (valor)

      se (valor % 2 == 0)
      {
        escreva ("\nEste número é par!", "\n")
      }
      senao
      {
        escreva ("\nEste número é ímpar!", "\n")
      }
    
  }
}
