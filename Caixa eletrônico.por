programa {
  funcao inicio() {
  
  escreva("CAIXA ELETRÔNICO! \n")

  //consultar
  //saque
  //depositar

  inteiro opcao
  real saldo = 10000.0
  real valor

  faca {
    escreva("1 - Consultar \n")
    escreva("2 - Saque \n")
    escreva("3 - Depositar \n")

    escreva("\nQual opção quer ir? (1|2|3): ")
    leia(opcao)

    escolha {
      caso 1:
        escreva(saldo)

        
    }

  }


    
  }
}
